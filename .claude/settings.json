{
  "env": {
    "KEELER_CRAP_MAX": "10"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-ocr-review.sh",
            "statusMessage": "Checking OCR review before commit"
          }
        ]
      }
    ]
  }
}
